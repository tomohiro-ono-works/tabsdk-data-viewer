<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.example.tabsdk-data-viewer-batch-v14" extension-version="0.20.0">
    <default-locale>ja_JP</default-locale>
    <name resource-id="name"/>
    <description>Tableau Viz Extension 用の大容量帳票ビューア</description>
    <author
      name="Development Team"
      email="support@example.com"
      organization="Example"
      website="https://example.com"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://tomohiro-ono-works.github.io/tabsdk-data-viewer/preview/batch-v14/index.html?preview=batch-v14-20261015</url>
    </source-location>
    <icon/>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
    <encoding id="rows">
      <display-name>表示列</display-name>
      <fields max-count="50"/>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="ja_JP">Data Viewer Batch 1000 V14</text>
    </resource>
  </resources>
</manifest>